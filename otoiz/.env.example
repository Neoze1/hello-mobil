# Kopyasını .env olarak kaydet. Anahtarı sohbet veya kaynak kodunda paylaşma.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anahtar yoksa temel Türkçe arama otomatik olarak çalışır.
# Yapay zekâyı geçici olarak kapatmak için basic yaz.
VITRA_ASSISTANT_MODE=
# Aynı ağdaki telefonlara erişim. Yalnız bilgisayar için 127.0.0.1 yaz.
VITRA_HOST=0.0.0.0
PORT=3000
# Public contact details; leave empty until real contact information is provided.
OTOIZ_CONTACT_EMAIL=
OTOIZ_CONTACT_PHONE=
OTOIZ_CONTACT_ADDRESS=
